{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Focus Launcher",
  "version": "0.1.0",
  "identifier": "org.focuslauncher.app",
  "build": {
    "frontendDist": "../focus-ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": {
      "script": "trunk serve --port 1420",
      "cwd": "../focus-ui"
    },
    "beforeBuildCommand": {
      "script": "trunk build --release && cargo build -p focus-guardian --release",
      "cwd": "../focus-ui"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Focus Launcher",
        "fullscreen": true,
        "decorations": false,
        "resizable": false,
        "visible": false,
        "backgroundColor": "#0b0d10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; connect-src ipc: http://ipc.localhost",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "license": "GPL-3.0-or-later",
    "resources": {
      "../../target/release/focus-guardian.exe": "focus-guardian.exe"
    }
  }
}