{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Focus Launcher",
  "version": "0.1.0",
  "identifier": "org.focuslauncher.app",
  "build": {
    "frontendDist": "../focus-ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": {
      "script": "trunk serve --port 1420",
      "cwd": "../focus-ui"
    },
    "beforeBuildCommand": {
      "script": "trunk build --release && cargo build -p focus-guardian --release --target x86_64-pc-windows-msvc",
      "cwd": "../focus-ui"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Focus Launcher",
        "fullscreen": true,
        "decorations": false,
        "resizable": false,
        "visible": false,
        "backgroundColor": "#0b0d10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: http://focusart.localhost focusart:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost",
      "capabilities": [
        "default"
      ]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1OEI3MjZFNTYyOUJENEIKUldSTHZTbFdibktMSlNBbk9YZVhWRFkwb3FhNEl5TzYra3F3d1c1UkdaaGQ0REttc3Y4Um96eTkK",
      "endpoints": [
        "https://github.com/Dofsan-creator/focus-launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "license": "GPL-3.0-or-later",
    "resources": {
      "../../target/x86_64-pc-windows-msvc/release/focus-guardian.exe": "guardian/focus-guardian.exe"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "French",
          "English",
          "Spanish",
          "German",
          "Italian",
          "PortugueseBR",
          "Russian",
          "Japanese",
          "Korean",
          "SimpChinese",
          "Arabic"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerHooks": "./nsis-hooks.nsh"
      }
    },
    "shortDescription": "Lanceur plein écran qui transforme Windows en console",
    "publisher": "Dofsan"
  }
}
